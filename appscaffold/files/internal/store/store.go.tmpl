// Package store owns the SQLite database. All SQL of the app lives here.
package store

import (
	"context"
	"database/sql"
	"errors"
	"os"
	"path/filepath"
	"time"

	"github.com/platform-upstream/app-foundation/sqlite"

	"__MODULE__/migrations"
)

// ErrNotFound reports a missing row.
var ErrNotFound = errors.New("not found")

// Note is the example record of the scaffold: replace it with the app's own data. Each note belongs
// to one person (directory id); every query takes the person and filters by it.
type Note struct {
	ID        int64     `json:"id"`
	Text      string    `json:"text"`
	CreatedAt time.Time `json:"createdAt"`
}

type Store struct {
	db  *sql.DB
	now func() time.Time
}

// Open opens the database at path, creating its directory, and applies pending migrations.
func Open(ctx context.Context, path string) (*Store, error) {
	if err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {
		return nil, err
	}
	db, err := sqlite.Open(ctx, path, sqlite.Options{})
	if err != nil {
		return nil, err
	}
	if err := sqlite.Migrate(ctx, db, migrations.FS, "."); err != nil {
		_ = db.Close()
		return nil, err
	}
	return &Store{db: db, now: time.Now}, nil
}

func (s *Store) Close() error { return s.db.Close() }

// Ping reports whether the database answers; it backs the readiness probe (/readyz).
func (s *Store) Ping(ctx context.Context) error { return s.db.PingContext(ctx) }

// Notes returns the person's notes, newest first.
func (s *Store) Notes(ctx context.Context, personID string) ([]Note, error) {
	rows, err := s.db.QueryContext(ctx, `SELECT id, text, created_at FROM notes WHERE person_id = ? ORDER BY id DESC`, personID)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	notes := []Note{}
	for rows.Next() {
		var n Note
		var created int64
		if err := rows.Scan(&n.ID, &n.Text, &created); err != nil {
			return nil, err
		}
		n.CreatedAt = time.UnixMilli(created).UTC()
		notes = append(notes, n)
	}
	return notes, rows.Err()
}

// AddNote stores a note of the person and returns it.
func (s *Store) AddNote(ctx context.Context, personID, text string) (Note, error) {
	if personID == "" {
		return Note{}, errors.New("a note needs a person")
	}
	created := s.now().UTC().Truncate(time.Millisecond)
	result, err := s.db.ExecContext(ctx, `INSERT INTO notes (person_id, text, created_at) VALUES (?, ?, ?)`, personID, text, created.UnixMilli())
	if err != nil {
		return Note{}, err
	}
	id, err := result.LastInsertId()
	if err != nil {
		return Note{}, err
	}
	return Note{ID: id, Text: text, CreatedAt: created}, nil
}

// DeleteNote removes one of the person's notes; ErrNotFound when the person has no such note
// (another person's note included).
func (s *Store) DeleteNote(ctx context.Context, personID string, id int64) error {
	result, err := s.db.ExecContext(ctx, `DELETE FROM notes WHERE id = ? AND person_id = ?`, id, personID)
	if err != nil {
		return err
	}
	if n, err := result.RowsAffected(); err != nil {
		return err
	} else if n == 0 {
		return ErrNotFound
	}
	return nil
}
