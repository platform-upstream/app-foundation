package api

import (
	"context"
	"net/http"
	"net/http/httptest"
	"path/filepath"
	"strings"
	"testing"

	"__MODULE__/internal/store"
)

func TestNotesAPI(t *testing.T) {
	st, err := store.Open(context.Background(), filepath.Join(t.TempDir(), "test.sqlite"))
	if err != nil {
		t.Fatal(err)
	}
	defer st.Close()
	h := New(st, "https://__APP_HOST__").Routes()

	do := func(method, path, body string, headers map[string]string) *httptest.ResponseRecorder {
		req := httptest.NewRequest(method, path, strings.NewReader(body))
		if body != "" {
			req.Header.Set("Content-Type", "application/json")
		}
		for k, v := range headers {
			req.Header.Set(k, v)
		}
		rec := httptest.NewRecorder()
		h.ServeHTTP(rec, req)
		return rec
	}

	if rec := do(http.MethodPost, "/api/notes", `{"text":"  hello  "}`, nil); rec.Code != http.StatusCreated || !strings.Contains(rec.Body.String(), `"text":"hello"`) {
		t.Fatalf("create: %d %s", rec.Code, rec.Body)
	}
	if rec := do(http.MethodPost, "/api/notes", `{"text":" "}`, nil); rec.Code != http.StatusBadRequest {
		t.Fatalf("empty note: %d", rec.Code)
	}
	if rec := do(http.MethodPost, "/api/notes", `{"text":"x"}`, map[string]string{"Origin": "https://evil.example"}); rec.Code != http.StatusForbidden {
		t.Fatalf("cross-site create: %d", rec.Code)
	}
	if rec := do(http.MethodGet, "/api/notes", "", nil); rec.Code != http.StatusOK || !strings.Contains(rec.Body.String(), "hello") {
		t.Fatalf("list: %d %s", rec.Code, rec.Body)
	}
	if rec := do(http.MethodDelete, "/api/notes/1", "", nil); rec.Code != http.StatusNoContent {
		t.Fatalf("delete: %d", rec.Code)
	}
	if rec := do(http.MethodDelete, "/api/notes/1", "", nil); rec.Code != http.StatusNotFound {
		t.Fatalf("delete again: %d", rec.Code)
	}
	if rec := do(http.MethodGet, "/api/unknown", "", nil); rec.Code != http.StatusNotFound || !strings.Contains(rec.Body.String(), `"error"`) {
		t.Fatalf("unknown route: %d %s", rec.Code, rec.Body)
	}
}
