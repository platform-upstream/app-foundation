// Command __APP_NAME__ serves __APP_TITLE__: its JSON API and the embedded React frontend.
package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"

	"github.com/platform-upstream/app-foundation/access"
	"github.com/platform-upstream/app-foundation/httpx"
	"github.com/platform-upstream/app-foundation/identity"
	"github.com/platform-upstream/app-foundation/server"
	"github.com/platform-upstream/app-foundation/web"

	"__MODULE__/internal/api"
	"__MODULE__/internal/store"
	appweb "__MODULE__/web"
)

func main() {
	if err := run(); err != nil {
		slog.Error("__APP_NAME__ stopped", "error", err)
		os.Exit(1)
	}
}

func run() error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// The chart sets APP_ADDR=:8080. The default is the local preview, where AUTH_MODE=local is
	// accepted because the listener is loopback.
	addr := env("APP_ADDR", "127.0.0.1:__APP_PORT__")
	// AUTH_MODE, CF_TEAM_DOMAIN, CF_ACCESS_AUD, CF_ACCESS_SERVICE_TOKENS (set by the chart).
	authConfig, err := access.ConfigFromEnv(addr)
	if err != nil {
		return err
	}
	auth, err := access.New(authConfig)
	if err != nil {
		return err
	}
	people, err := newPeople(authConfig.Mode)
	if err != nil {
		return err
	}
	st, err := store.Open(ctx, env("APP_DB", ".local/__APP_NAME__.sqlite"))
	if err != nil {
		return err
	}
	defer func() {
		if err := st.Close(); err != nil {
			slog.Error("close database", "error", err)
		}
	}()
	handler, err := newHandler(st, auth, people, os.Getenv("APP_ORIGIN"))
	if err != nil {
		return err
	}
	slog.Info("__APP_NAME__ listening", "address", addr)
	return server.Run(ctx, server.New(addr, handler))
}

// people says who a request is: in production directory's identity API (DIRECTORY_URL,
// DIRECTORY_KEY, set by the chart) behind a cache; in the local preview a fixed owner, because
// directory is not reachable from a workstation.
type people struct {
	resolver identity.Resolver
	options  identity.Options
}

func newPeople(mode access.Mode) (people, error) {
	if mode == access.ModeLocal {
		return people{options: identity.Options{Local: &identity.Person{ID: "local", Name: "Local preview", Role: "owner"}}}, nil
	}
	cfg, err := identity.ConfigFromEnv()
	if err != nil {
		return people{}, err
	}
	client, err := identity.NewClient(cfg)
	if err != nil {
		return people{}, err
	}
	return people{resolver: identity.NewCache(client, identity.CacheOptions{})}, nil
}

// newHandler composes the routes in the foundation's order: security headers, the public shallow
// /healthz (liveness) and /readyz (readiness: the database answers), the public /pwa/ files
// (manifest and icons, see web.PublicPrefix), then Cloudflare Access for everything else, static
// files included. The API also needs a directory person (identity.Middleware).
func newHandler(st *store.Store, auth *access.Authenticator, who people, origin string) (http.Handler, error) {
	if auth == nil {
		return nil, errors.New("authenticator is required")
	}
	spa, err := web.Handler(appweb.Files())
	if err != nil {
		return nil, err
	}
	protected := http.NewServeMux()
	who.options.Reject = func(w http.ResponseWriter, _ *http.Request, err error) {
		switch {
		case errors.Is(err, identity.ErrUnknown), errors.Is(err, identity.ErrActFor):
			_ = httpx.WriteError(w, http.StatusForbidden, "This account has no access to this app.")
		case errors.Is(err, identity.ErrNoCaller):
			_ = httpx.WriteError(w, http.StatusUnauthorized, "Please sign in again.")
		default:
			slog.Warn("identity unavailable", "error", err)
			_ = httpx.WriteError(w, http.StatusServiceUnavailable, "Sign-in is unavailable right now. Try again shortly.")
		}
	}
	protected.Handle("/api/", identity.Middleware(who.resolver, who.options)(api.New(st, origin).Routes()))
	protected.Handle("/", spa)
	gated := auth.Middleware(func(w http.ResponseWriter, _ *http.Request, _ error) {
		_ = httpx.WriteError(w, http.StatusUnauthorized, "Please sign in again.")
	})(protected)

	mux := http.NewServeMux()
	mux.Handle("GET /healthz", server.Health())
	mux.Handle("GET /readyz", server.Ready(st.Ping))
	mux.Handle("/", web.PublicFiles(spa, gated))
	return web.Headers(web.HeaderPolicy{CSP: csp})(mux), nil
}

// csp is the app's Content-Security-Policy; web.Headers adds the other security headers (nosniff,
// Referrer-Policy, X-Frame-Options, COOP, HSTS, Permissions-Policy). Widen it here when the app
// needs another origin; keep inline script out.
const csp = "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

func env(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
